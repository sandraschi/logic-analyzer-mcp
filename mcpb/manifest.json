    { "name": "la_help_quickstart", "description": "la_help(quickstart)" },
    { "name": "la_help_faq", "description": "la_help(faq)" },
    { "name": "la_help_hardware_guide", "description": "la_help(hardware_guide)" },
    { "name": "la_trigger", "description": "la_trigger" },
    { "name": "la_trigger_set", "description": "la_trigger(set)" },
    { "name": "la_trigger_get", "description": "la_trigger(get)" }
  ]
}
