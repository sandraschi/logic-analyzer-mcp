{
  "manifest_version": "0.2",
  "name": "logic-analyzer-mcp",
  "version": "0.1.0",
  "description": "FastMCP 3.2+ server for USB logic analyzers via sigrok and simulator backends with protocol decoding and fleet webapp.",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "src/logic_analyzer_mcp/__main__.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","python","-m","logic_analyzer_mcp"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "get_logs", "description": "get_logs" },
    { "name": "clear_logs", "description": "clear_logs" },
    { "name": "export_logs", "description": "export_logs" },
    { "name": "health", "description": "health" },
    { "name": "api_status", "description": "api_status" },
    { "name": "api_capabilities", "description": "api_capabilities" },
    { "name": "api_tools", "description": "api_tools" },
    { "name": "api_tool_call", "description": "api_tool_call" },
    { "name": "api_capture_last", "description": "api_capture_last" },
    { "name": "api_capture_run", "description": "api_capture_run" },
    { "name": "api_decode_last", "description": "api_decode_last" },
    { "name": "llm_providers", "description": "llm_providers" },
    { "name": "llm_chat", "description": "llm_chat" },
    { "name": "api_decode_run", "description": "api_decode_run" },
    { "name": "la_capture", "description": "la_capture" },
    { "name": "la_capture_single", "description": "la_capture(single)" },
    { "name": "la_capture_preview", "description": "la_capture(preview)" },
    { "name": "la_capture_export_csv", "description": "la_capture(export_csv)" },
    { "name": "la_capture_export_vcd", "description": "la_capture(export_vcd)" },
    { "name": "la_capture_export_summary", "description": "la_capture(export_summary)" },
    { "name": "la_capture_last", "description": "la_capture(last)" },
    { "name": "la_configure", "description": "la_configure" },
    { "name": "la_configure_channels", "description": "la_configure(channels)" },
    { "name": "la_configure_sample_rate", "description": "la_configure(sample_rate)" },
    { "name": "la_configure_get", "description": "la_configure(get)" },
    { "name": "la_configure_simulator_pattern", "description": "la_configure(simulator_pattern)" },
    { "name": "la_decode", "description": "la_decode" },
    { "name": "la_decode_list", "description": "la_decode(list)" },
    { "name": "la_decode_run", "description": "la_decode(run)" },
    { "name": "la_decode_last", "description": "la_decode(last)" },
    { "name": "la_decode_uart", "description": "la_decode(uart)" },
    { "name": "la_decode_i2c", "description": "la_decode(i2c)" },
    { "name": "la_decode_spi", "description": "la_decode(spi)" },
    { "name": "la_device", "description": "la_device" },
    { "name": "la_device_list", "description": "la_device(list)" },
    { "name": "la_device_connect", "description": "la_device(connect)" },
    { "name": "la_device_disconnect", "description": "la_device(disconnect)" },
    { "name": "la_device_status", "description": "la_device(status)" },
    { "name": "la_device_capabilities", "description": "la_device(capabilities)" },
    { "name": "la_device_backends", "description": "la_device(backends)" },
    { "name": "la_help", "description": "la_help" },
    { "name": "la_help_discover", "description": "la_help(discover)" },
    { "name": "la_help_tool_help", "description": "la_help(tool_help)" },
